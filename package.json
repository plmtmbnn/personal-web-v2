{
	"packageManager": "pnpm@12.4.2",
	"name": "personal-web-v2",
	"version": "0.134.0",
	"private": true,
	"scripts": {
		"dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --turbo --port 3000",
		"dev:debug": "cross-env NODE_OPTIONS='--inspect' NEXT_TELEMETRY_DISABLED=1 next dev --turbo --port 3000",
		"build": "cross-env NODE_OPTIONS='--max-old-space-size=8192' NEXT_TELEMETRY_DISABLED=1 next build",
		"build:fast": "cross-env NODE_OPTIONS='--max-old-space-size=8192' FAST_BUILD=true NEXT_TELEMETRY_DISABLED=1 next build",
		"build:dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --turbo --port 3001 & sleep 10 && pkill -f 'next dev.*3001' || true",
		"build:next": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
		"build:analyze": "cross-env ANALYZE=true NEXT_TELEMETRY_DISABLED=1 next build",
		"build:profile": "cross-env NODE_OPTIONS='--prof' NEXT_TELEMETRY_DISABLED=1 next build",
		"start": "next start",
		"check": "biome check --no-errors-on-unmatched .",
		"lint": "biome lint --no-errors-on-unmatched .",
		"format": "biome format --write --no-errors-on-unmatched .",
		"typecheck": "tsc --noEmit --pretty false --incremental false",
		"test": "vitest run",
		"macro:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/sync-macro.ts",
		"macro:seed:postgres": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-macro-postgres.ts",
		"prepare": "husky",
		"release": "semantic-release"
	},
	"dependencies": {
		"@hello-pangea/dnd": "^18.0.1",
		"@sentry/nextjs": "^11.15.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.2",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/typography": "^0.5.20",
		"@upstash/ratelimit": "^2.2.1",
		"@upstash/redis": "^1.41.0",
		"@vercel/speed-insights": "^2.1.0",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"firebase": "^13.4.0",
		"framer-motion": "^14.14.0",
		"lucide-react": "^1.77.0",
		"next": "16.4.6",
		"node-sql-parser": "^5.4.0",
		"otplib": "^13.6.0",
		"papaparse": "^5.7.1",
		"postcss": "^8.5.33",
		"qrcode": "^1.5.4",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hook-form": "^7.92.0",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"react-syntax-highlighter": "^16.1.2",
		"recharts": "^3.11.0",
		"remark-gfm": "^4.0.1",
		"sql-formatter": "^15.10.0",
		"tailwindcss": "^4.3.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@next/bundle-analyzer": "^16.4.6",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.11",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@sentry/cli": "^3.8.2",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.6",
		"@types/papaparse": "^5.5.2",
		"@types/qrcode": "^1.5.6",
		"@types/qrcode-terminal": "^0.12.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@vitest/ui": "^5.1.1",
		"autoprefixer": "^10.7.0",
		"cross-env": "^10.1.0",
		"depcheck": "^1.4.7",
		"husky": "^9.1.7",
		"jsdom": "^31.0.1",
		"qrcode-terminal": "^0.12.0",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	},
	"engines": {
		"node": ">=24.22.3"
	},
	"engineStrict": true,
	"type": "module"
}
