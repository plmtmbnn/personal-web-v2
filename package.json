{
	"packageManager": "pnpm@11.11.0",
	"name": "personal-web-v2",
	"version": "0.69.0",
	"private": true,
	"scripts": {
		"dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --turbo --port 3000",
		"dev:debug": "cross-env NODE_OPTIONS='--inspect' NEXT_TELEMETRY_DISABLED=1 next dev --turbo --port 3000",
		"build": "cross-env NODE_OPTIONS='--max-old-space-size=8192' NEXT_TELEMETRY_DISABLED=1 next build",
		"build:fast": "cross-env NODE_OPTIONS='--max-old-space-size=8192' FAST_BUILD=true NEXT_TELEMETRY_DISABLED=1 next build",
		"build:dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --turbo --port 3001 & sleep 10 && pkill -f 'next dev.*3001' || true",
		"build:next": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
		"build:analyze": "cross-env ANALYZE=true NEXT_TELEMETRY_DISABLED=1 next build",
		"build:profile": "cross-env NODE_OPTIONS='--prof' NEXT_TELEMETRY_DISABLED=1 next build",
		"start": "next start",
		"check": "biome check --no-errors-on-unmatched .",
		"lint": "biome lint --no-errors-on-unmatched .",
		"format": "biome format --write --no-errors-on-unmatched .",
		"test": "vitest run",
		"prepare": "husky",
		"release": "semantic-release"
	},
	"dependencies": {
		"@hello-pangea/dnd": "^18.0.1",
		"@mozilla/readability": "^0.6.0",
		"@sentry/nextjs": "^10.70.0",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.112.3",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.38.2",
		"@vercel/speed-insights": "^2.0.0",
		"chart.js": "^4.5.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"dompurify": "^3.4.13",
		"firebase": "^12.17.1",
		"framer-motion": "^13.1.0",
		"got-scraping": "^4.2.1",
		"jsdom": "^30.0.1",
		"lucide-react": "^1.31.0",
		"next": "16.3.1",
		"node-sql-parser": "^5.4.0",
		"otplib": "^13.4.1",
		"papaparse": "^5.6.0",
		"postcss": "^8.5.26",
		"qrcode": "^1.5.4",
		"react": "19.2.8",
		"react-chartjs-2": "^5.3.1",
		"react-dom": "19.2.8",
		"react-force-graph-2d": "^1.29.1",
		"react-hook-form": "^7.85.0",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"react-syntax-highlighter": "^16.1.1",
		"recharts": "^3.10.1",
		"sql-formatter": "^15.8.2",
		"tailwindcss": "^4.3.3",
		"turndown": "^7.2.4",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@next/bundle-analyzer": "^16.3.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@sentry/cli": "^3.6.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.2.0",
		"@types/papaparse": "^5.5.2",
		"@types/qrcode": "^1.5.6",
		"@types/qrcode-terminal": "^0.12.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/turndown": "^5.0.6",
		"@vitest/ui": "^4.1.10",
		"autoprefixer": "^10.5.4",
		"cross-env": "^10.1.0",
		"depcheck": "^1.4.7",
		"husky": "^9.1.7",
		"qrcode-terminal": "^0.12.0",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2",
		"uuid-random": "^1.3.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": "24.x"
	},
	"engineStrict": true,
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"type": "module"
}
